{
  "name": "euler-identity",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "欧拉恒等式 e^(iπ) + 1 = 0 的互动科普展览",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --pretty",
    "test": "vitest run",
    "film:preview": "remotion studio remotion/index.ts",
    "film:still": "remotion still remotion/index.ts EulerIdentity out/still.png --frame=1150",
    "export:mp4": "remotion render remotion/index.ts EulerIdentity out/euler-identity.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --log=info"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.536",
    "@remotion/cli": "^4.0.536",
    "@remotion/renderer": "^4.0.536",
    "@remotion/studio": "^4.0.536",
    "katex": "^0.16.11",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.536"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/katex": "^0.16.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
